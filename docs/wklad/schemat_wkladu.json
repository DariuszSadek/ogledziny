{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ogledziny-wklad-2",
 "title": "Wkład do formularzy oględzin (wersja 2; wersja 1 nadal wczytywana)",
 "type": "object",
 "required": [
  "format",
  "wersja"
 ],
 "additionalProperties": true,
 "properties": {
  "format": {
   "const": "ogledziny-wklad"
  },
  "wersja": {
   "enum": [
    1,
    2
   ]
  },
  "rewizja": {
   "type": "integer",
   "minimum": 1
  },
  "sprawa": {
   "type": "object",
   "properties": {
    "sygnatura": {
     "type": "string"
    },
    "organ": {
     "type": "string"
    },
    "data": {
     "type": "string"
    },
    "opis": {
     "type": "string"
    }
   }
  },
  "formularze": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "ref",
     "formularz"
    ],
    "properties": {
     "ref": {
      "type": "string",
      "minLength": 1
     },
     "formularz": {
      "type": "string",
      "pattern": "^0[0-9]$"
     },
     "etykieta": {
      "type": "string"
     },
     "pola": {
      "type": "object",
      "additionalProperties": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "przypomnienia": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "zadania": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "czynnosc"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "formularz": {
      "type": "string"
     },
     "sekcja": {
      "type": "string"
     },
     "pole": {
      "type": "string"
     },
     "czynnosc": {
      "type": "string",
      "maxLength": 200
     },
     "opis": {
      "type": "string"
     },
     "podstawa": {
      "type": "string"
     },
     "przyrzad": {
      "type": "string"
     },
     "jednostka": {
      "type": "string"
     },
     "priorytet": {
      "enum": [
       "wysoki",
       "normalny",
       "niski"
      ]
     },
     "wynik": {
      "type": "string"
     },
     "nr_zdjecia": {
      "type": "string"
     },
     "status": {
      "enum": [
       "",
       "wykonane",
       "niewykonane"
      ]
     },
     "powod": {
      "type": "string"
     },
     "zalacznik": {
      "type": "string",
      "description": "id załącznika z tablicy zalaczniki"
     }
    }
   }
  },
  "uwagi_ogolne": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "zalaczniki": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "rodzaj"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[SFI][0-9]+$"
     },
     "rodzaj": {
      "enum": [
       "szkic",
       "zdjęcie",
       "inne"
      ]
     },
     "podstawa": {
      "type": "string"
     },
     "opis": {
      "type": "string"
     },
     "cel": {
      "type": "string"
     }
    }
   }
  }
 }
}